# Copie ce fichier en .env et remplis tes valeurs. Ne commite JAMAIS .env.

# ── Deriv ─────────────────────────────────────────────────────────────
DERIV_APP_ID=1089
DERIV_API_TOKEN=REMPLACE_PAR_TON_TOKEN
DERIV_ACCOUNT_TYPE=demo        # demo | real
DERIV_ALLOW_REAL=0             # 1 = autorise un compte réel. NE PAS activer avant validation.
DERIV_SYMBOL=CRASH500
DERIV_GRANULARITY=60           # taille des bougies, en secondes
DERIV_DUR=240                  # durée des contrats, en secondes

# ── Capital & risque ──────────────────────────────────────────────────
CAPITAL_USD=150
AUTO_STAKE=2.0
DERIV_AUTO_MAX_STAKE=5
DERIV_MANUAL_THRESHOLD=5
MAX_RISK_PCT=0.02
DAILY_STOP_PCT=0.10
MAX_CONSECUTIVE=3
CYCLE_SEC=60

# ── Telegram (optionnel) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Divers ────────────────────────────────────────────────────────────
JOURNAL_DB=
RUN_NETWORK_TESTS=0
DERIV_AUTO_OPEN_BROWSER=0
