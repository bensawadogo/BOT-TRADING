# Copie ce fichier en .env et remplis tes valeurs. Ne commite JAMAIS .env.

# ── Deriv ─────────────────────────────────────────────────────────────
DERIV_APP_ID=1089
DERIV_API_TOKEN=REMPLACE_PAR_TON_TOKEN
DERIV_ACCOUNT_TYPE=demo        # demo | real
DERIV_ALLOW_REAL=0             # 1 = autorise un compte réel. NE PAS activer avant validation.
DERIV_SYMBOL=BOOM500           # ⚠️ drift sans edge (audit 08/10/2026) : ne pas trader
DERIV_STRATEGY=auto            # auto (drift sur BOOM/CRASH) | drift | ensemble
DERIV_GRANULARITY=60           # taille des bougies, en secondes (M1 = validé)
DERIV_DUR=240                  # durée des contrats en mode ensemble (s) ;
                               # en mode drift : 10 bougies, fixé par la stratégie

# ── Capital & risque ──────────────────────────────────────────────────
CAPITAL_USD=150
AUTO_STAKE=2.0
DERIV_AUTO_MAX_STAKE=5
DERIV_MANUAL_THRESHOLD=5
MAX_RISK_PCT=0.02
DAILY_STOP_PCT=0.10
MAX_CONSECUTIVE=3
CYCLE_SEC=60

# ── Telegram (optionnel) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Divers ────────────────────────────────────────────────────────────
JOURNAL_DB=
RUN_NETWORK_TESTS=0
DERIV_AUTO_OPEN_BROWSER=0

# ── Bot de tendance MT5 (python main.py trend) ──────────────────────
# Laisser vides si le terminal MT5 est déjà ouvert et connecté.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_ALLOW_REAL=0               # 1 = autorise un compte réel. Démo d'abord.
TREND_SYMBOLS=                 # vide = tous ; ex. EURUSD,XAUUSD,NAS100
TREND_PORT_VOL=0.10            # volatilité annuelle visée (10 %)
TREND_MAX_GROSS=3              # levier brut maximum
TREND_SOFT_DD=0.10             # drawdown → exposition divisée par 2
TREND_HARD_DD=0.20             # drawdown → tout fermé, reset manuel
TREND_RUN_HOUR_UTC=7           # heure du cycle quotidien (--loop), marchés ouverts
