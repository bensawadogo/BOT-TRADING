# Copie ce fichier en .env et remplis tes valeurs. Ne commite JAMAIS .env.

# ── Terminal MT5 (laisser vide si MT5 est déjà ouvert et connecté) ────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_ALLOW_REAL=0               # 1 = autorise un compte réel. 3 mois de démo d'abord.

# ── Bot de tendance ──────────────────────────────────────────────────
TREND_SYMBOLS=                 # vide = panier backtesté ; ex. EURUSD,GBPUSD,NAS100
TREND_PORT_VOL=0.10            # volatilité annuelle visée (10 %)
TREND_MAX_GROSS=3              # levier brut maximum
TREND_SOFT_DD=0.10             # drawdown → exposition divisée par 2
TREND_HARD_DD=0.20             # drawdown → tout fermé, reset manuel
TREND_RUN_HOUR_UTC=7           # heure du cycle quotidien (--loop), marchés ouverts

# ── Telegram (optionnel) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
