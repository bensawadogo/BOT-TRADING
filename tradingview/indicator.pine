//@version=5
indicator("Trading Algo Africa — HMM+Kalman+Consensus", overlay=true)

// Paramètres
gain        = input.float(0.3, "Kalman Gain", 0.01, 1.0, 0.01)
fast        = input.int(20, "EMA rapide")
slow        = input.int(50, "EMA lente")
score_buy   = input.int(65, "Score BUY minimum")
score_sell  = input.int(35, "Score SELL maximum")

// Filtre de Kalman (approximation Pine)
var float kprice = na
var float kerror = na
if na(kprice)
    kprice := close
    kerror := 1.0
kg     = gain / (gain + kerror)
kprice := kprice + kg * (close - kprice)
kerror := (1.0 - kg) * kerror
plot(kprice, "Kalman", color.new(color.blue, 0), 2)

// Régime (proxy HMM)
ema_f     = ta.ema(close, fast)
ema_s     = ta.ema(close, slow)
atr_r     = ta.atr(14) / ta.sma(ta.atr(14), 50)
bull      = ema_f > ema_s and atr_r < 1.5
bear      = ema_f < ema_s and atr_r < 1.5
bgcolor(bull ? color.new(color.green, 90) : bear ? color.new(color.red, 90) : color.new(color.gray, 90))

// Score consensus
rsi_v            = ta.rsi(close, 14)
[m, ms, _]       = ta.macd(close, 12, 26, 9)
[bbm, bbu, bbl]  = ta.bb(close, 20, 2)
rsc              = rsi_v < 35 ? 20 : rsi_v > 65 ? -20 : 0
msc              = m > ms ? 15 : -15
ksc              = close < kprice * 0.99 ? 15 : close > kprice * 1.01 ? -15 : 0
bsc              = close < bbl ? 10 : close > bbu ? -10 : 0
reg_sc           = bull ? 15 : bear ? -15 : 0
score            = 50 + rsc + msc + ksc + bsc + reg_sc

// Signaux
buy       = score >= score_buy  and ta.crossover(close, bbl)
sell      = score <= score_sell and ta.crossunder(close, bbu)
plotshape(buy,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.normal)
plotshape(sell, "SELL", shape.triangledown, location.abovebar, color.red,   size=size.normal)

// Dashboard
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    r = bull ? "🟢 Bull" : bear ? "🔴 Bear" : "⚪ Range"
    table.cell(t, 0, 0, "Régime",   text_color=color.gray)
    table.cell(t, 1, 0, r,          text_color=bull ? color.green : bear ? color.red : color.gray)
    table.cell(t, 0, 1, "Score",    text_color=color.gray)
    table.cell(t, 1, 1, str.tostring(score) + "/100", text_color=score >= score_buy ? color.green : score <= score_sell ? color.red : color.white)
    table.cell(t, 0, 2, "RSI",      text_color=color.gray)
    table.cell(t, 1, 2, str.tostring(math.round(rsi_v, 1)), text_color=rsi_v < 35 ? color.green : rsi_v > 65 ? color.red : color.white)
    table.cell(t, 0, 3, "Kalman Δ", text_color=color.gray)
    table.cell(t, 1, 3, str.tostring(math.round((close - kprice) / kprice * 100, 2)) + "%", text_color=close < kprice ? color.green : color.red)
    table.cell(t, 0, 4, "Signal",   text_color=color.gray)
    table.cell(t, 1, 4, buy ? "🟢 BUY" : sell ? "🔴 SELL" : "⏳ WAIT", text_color=buy ? color.green : sell ? color.red : color.gray)

alertcondition(buy,  "BUY",  "Trading Algo Africa — BUY Signal")
alertcondition(sell, "SELL", "Trading Algo Africa — SELL Signal")
